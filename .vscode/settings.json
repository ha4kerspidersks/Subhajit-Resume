{
  "latex-workshop.latex.outDir": "%DIR%/dist",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk ➔ dist/Subhajit_Kar_Resume.pdf",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatex ➔ pdflatex (clean double-pass)",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%DIR%/dist",
        "-jobname=Subhajit_Kar_Resume",
        "%DOC%"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/Library/TeX/texbin:/usr/local/bin:${env:PATH}"
      }
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-output-directory=%DIR%/dist",
        "-jobname=Subhajit_Kar_Resume",
        "%DOC%"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/Library/TeX/texbin:/usr/local/bin:${env:PATH}"
      }
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.fls",
    "*.log",
    "*.out",
    "*.fdb_latexmk",
    "*.synctex.gz",
    "*.toc",
    "*.xdv"
  ]
}
